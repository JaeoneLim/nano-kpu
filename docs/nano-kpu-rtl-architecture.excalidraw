    {
      "type": "text",
      "id": "subtitle",
      "x": 42,
      "y": 70,
      "width": 1100,
      "height": 25,
      "text": "nano challenge: vocab=512. Real Kimi K3: vocab=160K. Runtime header fields are flexible; physical RTL storage is not.",
      "originalText": "nano challenge: vocab=512. Real Kimi K3: vocab=160K. Runtime header fields are flexible; physical RTL storage is not.",
